            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "nullable": true,
            "type": "string",
            "maxLength": 2000
          },
          "imageUrl": {
            "nullable": true,
            "type": "string",
            "maxLength": 2000,
            "format": "uri"
          },
          "sourceUrl": {
            "nullable": true,
            "type": "string",
            "maxLength": 2000,
            "format": "uri"
          },
          "baseServings": {
            "default": 2,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "totalMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10080
          },
          "difficulty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "steps": {
            "minItems": 1,
