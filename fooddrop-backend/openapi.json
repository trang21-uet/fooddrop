  "info": {
    "title": "Food Drop API",
    "description": "",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthChecksDto": {
        "type": "object",
        "properties": {
          "postgres": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          },
          "redis": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          }
        },
        "required": [
          "postgres",
          "redis"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "checks": {
            "$ref": "#/components/schemas/HealthChecksDto"
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "CreateUpload": {
        "type": "object",
        "properties": {
          "purpose": {
            "default": "parser",
            "type": "string",
            "enum": [
              "parser",
              "recipe-step"
            ]
          },
          "contentType": {
            "type": "string",
            "enum": [
              "image/jpeg",
              "image/png",
              "image/webp"
            ]
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5242880
          }
        },
        "required": [
          "contentType",
          "sizeBytes"
        ]
      },
      "UploadTarget": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "uploadUrl": {
            "type": "string",
            "format": "uri"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "expiresInSeconds": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "key",
          "uploadUrl",
          "headers",
          "expiresInSeconds"
        ],
        "additionalProperties": false
      },
      "CreateParseJob": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2000,
            "format": "uri"
          },
          "imageKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      },
      "ParseJob": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed"
            ]
          },
          "sourceType": {
            "type": "string",
            "enum": [
              "url",
              "image"
            ]
          },
          "errorCode": {
            "nullable": true,
            "type": "string",
            "enum": [
              "url_blocked",
              "fetch_failed",
              "not_a_recipe",
              "image_unreadable",
              "parser_unavailable",
              "internal_error"
            ]
          },
          "result": {
            "nullable": true,
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "json-ld",
                  "llm-text",
                  "llm-vision"
                ]
              },
              "title": {
                "type": "string"
              },
              "description": {
                "nullable": true,
                "type": "string"
              },
              "imageUrl": {
                "nullable": true,
                "type": "string"
              },
              "sourceUrl": {
                "nullable": true,
                "type": "string"
              },
              "baseServings": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "totalMinutes": {
                "nullable": true,
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "difficulty": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "ingredients": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "quantity": {
                      "nullable": true,
                      "type": "number"
                    },
                    "unit": {
                      "nullable": true,
                      "type": "string"
                    },
                    "note": {
                      "nullable": true,
                      "type": "string"
                    },
                    "matchedName": {
                      "nullable": true,
                      "type": "string"
                    },
                    "ingredientId": {
                      "nullable": true,
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "isNew": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "name",
                    "quantity",
                    "unit",
                    "note",
                    "matchedName",
                    "ingredientId",
                    "isNew"
                  ],
                  "additionalProperties": false
                }
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "timerSeconds": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "text"
                  ],
                  "additionalProperties": false
                }
              },
              "suggestedTagIds": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              }
            },
            "required": [
              "source",
              "title",
              "description",
              "imageUrl",
              "sourceUrl",
              "baseServings",
              "totalMinutes",
              "difficulty",
              "ingredients",
              "steps",
              "suggestedTagIds"
            ],
            "additionalProperties": false
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "status",
          "sourceType",
          "errorCode",
          "result",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "Ingredient": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "aisle": {
            "type": "string",
            "enum": [
              "produce",
              "meat",
              "seafood",
              "dairy",
              "pantry",
              "spices",
              "frozen",
              "other"
            ]
          },
          "defaultUnit": {
            "type": "string",
            "enum": [
              "g",
              "ml",
              "piece"
            ]
          },
          "densityGPerMl": {
            "nullable": true,
            "type": "number"
          },
          "isFermented": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "aliases",
          "aisle",
          "defaultUnit",
          "densityGPerMl",
          "isFermented"
        ],
        "additionalProperties": false
      },
      "SearchIngredientsQuery": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 100
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        }
      },
      "CreateIngredient": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "aliases": {
            "default": [],
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "aisle": {
            "default": "other",
            "type": "string",
            "enum": [
              "produce",
              "meat",
              "seafood",
              "dairy",
              "pantry",
              "spices",
              "frozen",
              "other"
            ]
          },
          "defaultUnit": {
            "default": "g",
            "type": "string",
            "enum": [
              "g",
              "ml",
              "piece"
            ]
          },
          "densityGPerMl": {
            "default": null,
            "nullable": true,
            "type": "number",
            "minimum": 0,
            "exclusiveMinimum": true,
            "maximum": 25
          }
        },
        "required": [
          "name"
        ]
      },
      "Unit": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "nameVi": {
            "type": "string"
          },
          "nameEn": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "mass",
              "volume",
              "count",
              "other"
            ]
          }
        },
        "required": [
          "code",
          "nameVi",
          "nameEn",
          "kind"
        ],
        "additionalProperties": false
      },
      "TagDimension": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "slug": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "slug": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "slug",
                "label"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "slug",
          "label",
          "tags"
        ],
        "additionalProperties": false
      },
      "RecipeInput": {
        "type": "object",
        "properties": {
