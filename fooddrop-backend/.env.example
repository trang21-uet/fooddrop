# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://fooddrop:fooddrop_dev@localhost:5432/fooddrop
REDIS_URL=redis://localhost:6379

# Auth
# AUTH_SECRET: 16+ random chars, e.g. `openssl rand -base64 32`
AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:4000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI recipe parser
ANTHROPIC_API_KEY=
PARSER_MODEL_TEXT=claude-haiku-4-5-20251001
PARSER_MODEL_VISION=claude-sonnet-5-5
# Imports per user per rolling 24h
PARSER_DAILY_QUOTA=30

# Context providers
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
GOOGLE_PLACES_API_KEY=

# Storage (S3-compatible: Cloudflare R2 in production). Values below match docker-compose (SeaweedFS).
# R2: set S3_ENDPOINT to https://<account>.r2.cloudflarestorage.com and add a bucket CORS rule allowing PUT from the web origin.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=fooddrop-media
S3_ACCESS_KEY_ID=fooddrop
S3_SECRET_ACCESS_KEY=fooddrop_dev
