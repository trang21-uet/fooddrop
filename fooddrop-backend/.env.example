# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://fooddrop:fooddrop_dev@localhost:5432/fooddrop
REDIS_URL=redis://localhost:6379

# Auth
AUTH_SECRET=change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI recipe parser
ANTHROPIC_API_KEY=
PARSER_MODEL_TEXT=claude-haiku-4-5-20251001
PARSER_MODEL_VISION=claude-sonnet-5-5

# Context providers
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
GOOGLE_PLACES_API_KEY=

# Storage (S3-compatible, e.g. Cloudflare R2)
S3_ENDPOINT=
S3_BUCKET=fooddrop-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
